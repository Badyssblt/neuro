meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "user@example.com",
    "password": "password123"
  }
}

script:after-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
  }
}
