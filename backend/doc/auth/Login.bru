meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: inherit
}

body:json {
  {
      "email": "user@example.com",
      "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
      bru.setEnvVar("token", res.body.token);
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
