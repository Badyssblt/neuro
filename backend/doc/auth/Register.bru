meta {
  name: Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: inherit
}

body:json {
  {
      "email": "user@example.com",
      "password": "password123"
    }
}

script:post-response {
  if (res.status === 201) {
      bru.setEnvVar("token", res.body.token);
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
