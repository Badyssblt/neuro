  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/ld+json
}

body:json {
  {
    "title": "Déclarer des variables typées",
    "content": "En TypeScript, on peut typer explicitement ses variables avec la syntaxe `let x: string = 'hello'`.",
    "summary": "Typage explicite des variables avec let, const et var.",
    "examples": "let age: number = 25;\nconst name: string = 'Alice';",
    "difficulty": "intermediate",
    "concept": "/api/concepts/1"
  }
}
