meta {
  name: Create Lesson
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/lessons
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/ld+json
}

body:json {
  {
    "title": "Déclarer des variables typées",
    "content": "En TypeScript, on peut typer explicitement ses variables avec la syntaxe `let x: string = 'hello'`.",
    "summary": "Typage explicite des variables avec let, const et var.",
    "examples": "let age: number = 25;\nconst name: string = 'Alice';\nlet active: boolean = true;",
    "difficulty": "beginner",
    "concept": "/api/concepts/1"
  }
}
